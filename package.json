{
  "name": "aios-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AIOS-Lite: template hệ điều hành agent — Claude Code, Codex, Grok và Hermes cùng làm việc, chung bộ nhớ, tri thức và skill.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false src/main.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node dist/src/main.js",
    "aios": "tsx src/cli/aios.ts",
    "test": "vitest run && node --test \"scripts/**/*.test.mjs\" && node scripts/check-provenance.mjs",
    "test:unit": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "provenance": "node scripts/check-provenance.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@composio/core": "^0.22.0",
    "@hono/node-server": "^1.19.17",
    "@preact/signals": "^2.11.3",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^5.10.2",
    "croner": "^10.0.1",
    "dompurify": "^3.4.17",
    "hono": "^4.13.13",
    "image-size": "^2.0.2",
    "lucide-preact": "^1.61.0",
    "marked": "^18.1.1",
    "pino": "^9.14.0",
    "preact": "^10.29.8",
    "wouter-preact": "^3.13.0",
    "yaml": "^2.9.1",
    "zca-js": "^2.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
