# AIOS-Lite — copy thành .env rồi sửa nếu cần. Mọi biến đều có mặc định.

# Cổng và địa chỉ của API + giao diện (chỉ nghe trên máy này)
AIOS_PORT=4380
AIOS_HOST=127.0.0.1

# Nếu đặt, mọi lời gọi API phải kèm header  Authorization: Bearer <token>
# AIOS_TOKEN=

# Số lượt agent chạy cùng lúc trên toàn hệ thống
AIOS_MAX_PARALLEL=3

# Thư mục dữ liệu (SQLite), skill và tri thức. Nhiều thư mục thì ngăn bằng dấu phẩy.
# AIOS_DATA_DIR=./data
# AIOS_SKILLS_DIRS=./skills
# AIOS_KNOWLEDGE_DIRS=./knowledge

# Giới hạn giao việc giữa các agent
AIOS_MAX_DELEGATION_DEPTH=3
AIOS_MAX_CHILDREN_PER_RUN=5

# Thời gian tối đa một lượt chạy (giây)
AIOS_RUN_TIMEOUT_SEC=900
