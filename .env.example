# AIOS-Lite — copy thành .env rồi sửa nếu cần. Mọi biến đều có mặc định.

# Cổng và địa chỉ của API + giao diện (chỉ nghe trên máy này)
AIOS_PORT=4380
AIOS_HOST=127.0.0.1

# Nếu đặt, mọi lời gọi API phải kèm header  Authorization: Bearer <token>
# AIOS_TOKEN=

# Số lượt agent chạy cùng lúc trên toàn hệ thống
AIOS_MAX_PARALLEL=3

# Thư mục dữ liệu (SQLite), skill và tri thức. Nhiều thư mục thì ngăn bằng dấu phẩy.
# AIOS_DATA_DIR=./data
# AIOS_SKILLS_DIRS=./skills
# AIOS_KNOWLEDGE_DIRS=./knowledge

# Giới hạn giao việc giữa các agent
AIOS_MAX_DELEGATION_DEPTH=3
AIOS_MAX_CHILDREN_PER_RUN=5

# Thời gian tối đa một lượt chạy (giây)
AIOS_RUN_TIMEOUT_SEC=900

# Múi giờ dùng cho lịch, báo cáo và trang Tổng quan
# AIOS_TIMEZONE=Asia/Ho_Chi_Minh

# ─────────────────────────────────────────────────────────────────────────────
# KHOÁ BÍ MẬT: chỉ đặt trong .env (file này đã nằm trong .gitignore, không bao giờ commit).
# Để trống thì tính năng dùng khoá đó tắt. Khoá nhập trên giao diện (Kết nối › Integrations,
# cài đặt module) được mã hoá và lưu trong data/aios.db, cũng không vào git.
# ─────────────────────────────────────────────────────────────────────────────

# Khoá mã hoá dữ liệu nhạy cảm trong data/ (khoá integration, tin Zalo, Gmail…).
# Để trống: lần chạy đầu app tự tạo một khoá ngẫu nhiên và ghi vào .env. Mất khoá = không đọc lại được dữ liệu đã mã hoá.
AIOS_ENCRYPTION_KEY=

# Composio: Facebook Page, Meta Ads, Gmail (module marketing, ads, gmail, kol)
COMPOSIO_API_KEY=

# Google Gemini / Veo (module kol, video)
GOOGLE_API_KEY=

# OpenAI: tạo ảnh qua API trong module kol (không cần nếu dùng `codex login` với gói ChatGPT)
OPENAI_API_KEY=

# fal.ai (module kol). Cũng nhập được ở Kết nối › Integrations
FAL_KEY=

# ElevenLabs: giọng đọc (module kol, video). Cũng nhập được ở Kết nối › Integrations
ELEVENLABS_API_KEY=

# HeyGen: video avatar (module video). Cũng nhập được ở Kết nối › Integrations
HEYGEN_API_KEY=

# Khoá API của chính các CLI agent, chỉ cần nếu không đăng nhập bằng lệnh login của CLI
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY (dùng chung dòng ở trên)
# XAI_API_KEY=
